        { "expr": "rate(dsp_rate_limit_events_total[5m])", "legendFormat": "429", "refId": "B" }
      ]
    },
    {
      "type": "stat",
      "title": "Background / restarts",
      "id": 32,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "dsp_system_restarts_total", "legendFormat": "restarts", "refId": "A" }
      ]
    }
