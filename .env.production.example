# DSP AI Indicator — Production environment template (EPIC-013 RC1)
# DO NOT commit real secrets. Use your secret manager in production.

DSP_ENVIRONMENT=production
DSP_APP_VERSION=1.0.0-rc1
DSP_RELEASE_CHANNEL=rc1
BUILD_TIMESTAMP=
GIT_SHA=

DSP_API_HOST=0.0.0.0
DSP_API_PORT=8000
DSP_ENABLE_SECURITY=true
DSP_JWT_SECRET=CHANGE_ME_USE_SECRET_MANAGER
DSP_CORS_ORIGINS=https://your-domain.example
DSP_GRACEFUL_SHUTDOWN_SECONDS=30
DSP_FORWARDED_ALLOW_IPS=*

DEFAULT_AI_PROVIDER=deterministic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.example/api/v1
NEXT_PUBLIC_APP_NAME=DSP AI Indicator
NEXT_PUBLIC_AI_PROVIDER=backend
NEXT_PUBLIC_BUILD_TIMESTAMP=

DSP_RATE_LIMIT_ENABLED=true
DSP_RATE_LIMIT_PER_MINUTE=600
