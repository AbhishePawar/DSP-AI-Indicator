# DSP staging environment template (EPIC-017)
# Copy to repo-root `.env.staging` (gitignored). Do not use production secrets here.

DSP_ENVIRONMENT=staging
DSP_APP_VERSION=2.0.0-rc.1
DSP_PLATFORM_VERSION=2.0.0
DSP_RELEASE_CHANNEL=rc
DSP_REGION=ap-south-1

DSP_PUBLIC_DOMAIN=staging.your-domain.example
DSP_API_DOMAIN=api.staging.your-domain.example
DSP_ACME_EMAIL=ops@your-domain.example
DSP_AUTO_HTTPS=on

DSP_API_IMAGE=dsp-api
DSP_WEB_IMAGE=dsp-web
DSP_IMAGE_TAG=2.0.0-rc.1
DSP_IMAGE_TAG_WEB=2.0.0-rc.1

DSP_ENABLE_SECURITY=true
DSP_REQUIRE_ADMIN_AUTH=true
DSP_HSTS_ENABLED=true
DSP_RATE_LIMIT_ENABLED=true
DSP_RATE_LIMIT_PER_MINUTE=1200
DSP_JWT_SECRET=CHANGE_ME_STAGING_JWT_MIN_32_CHARS
DSP_SEED_ADMIN_PASSWORD=CHANGE_ME_STAGING_ADMIN
DSP_CORS_ORIGINS=https://staging.your-domain.example

POSTGRES_USER=dsp
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DB
POSTGRES_DB=dsp
DSP_DATABASE_URL=postgresql://dsp:CHANGE_ME_STAGING_DB@postgres:5432/dsp
DSP_REDIS_URL=redis://redis:6379/0
DSP_REDIS_FALLBACK=false

DSP_TEMP_DIR=/tmp/dsp
DSP_BACKUP_DIR=/var/backups/dsp

NEXT_PUBLIC_API_BASE_URL=https://staging.your-domain.example/api/v1
NEXT_PUBLIC_APP_NAME=DSP AI Indicator (Staging)
NEXT_PUBLIC_AI_PROVIDER=backend

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STAGING_GRAFANA
GRAFANA_HOST_PORT=3001

DSP_SMOKE_API_BASE_URL=https://staging.your-domain.example
DSP_SMOKE_WEB_BASE_URL=https://staging.your-domain.example
DSP_SMOKE_REQUIRE_HTTPS=true

# Optional OpenTelemetry (vendor-neutral collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=dsp-api-staging
DSP_OTEL_ENABLED=false
DSP_SENTRY_DSN=
DSP_SENTRY_ENABLED=false
