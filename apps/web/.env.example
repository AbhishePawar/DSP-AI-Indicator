NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_APP_NAME=DSP AI Indicator

# PR1.0 Product modes — Phase 1 Research Mode defaults
NEXT_PUBLIC_RESEARCH_MODE=true
NEXT_PUBLIC_RECOMMENDATION_MODE=false
NEXT_PUBLIC_SEBI_MODE=false
NEXT_PUBLIC_SHOW_TARGET_PRICE=false
NEXT_PUBLIC_SHOW_BUY_SELL=false
NEXT_PUBLIC_SHOW_MODEL_PORTFOLIO=false
NEXT_PUBLIC_SHOW_RESEARCH_ALERTS=false

NEXT_PUBLIC_AI_PROVIDER=deterministic
NEXT_PUBLIC_BUILD_TIMESTAMP=
NEXT_PUBLIC_MARKET_CACHE_TTL_MS=60000
NEXT_PUBLIC_MARKET_REFRESH_MS=60000

# Epic V2.0 — Advisor Platform demo (optional; default off — single-user UX unchanged)
NEXT_PUBLIC_ADVISOR_DEMO=false
