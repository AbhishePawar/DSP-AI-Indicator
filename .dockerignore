# Keep the API image context small. Dockerfile COPY needs:
#   pyproject.toml, README.md, packages/, scripts/start-api.sh

.git
.github
.venv
venv
ENV
node_modules
**/node_modules
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
.next
out

# Keep non-web app trees out of Docker context; allow apps/web for the
# frontend Dockerfile (COPY apps/web/**). Backend image never COPY apps/.
apps/*
!apps/web/
!apps/web/**
artifacts
.bytecode_backup
docs
deploy
tools
release
tmp
temp
.cache

.env
.env.*
!.env.example

*.log
.DS_Store
Thumbs.db
.idea
.vscode
