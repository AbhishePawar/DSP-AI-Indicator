# DSP AI Indicator — Development environment template (EPS-003 / Version 2.0 RC)
# Copy to .env and adjust values. NEVER commit real secrets.

# --- Application ---
DSP_ENVIRONMENT=development
DSP_APP_VERSION=2.0.0-rc.1
DSP_RELEASE_CHANNEL=rc
BUILD_TIMESTAMP=
GIT_SHA=

# --- API ---
DSP_API_HOST=0.0.0.0
DSP_API_PORT=8000
DSP_ENABLE_SECURITY=false
# Dev placeholder only — production MUST use a secret manager (≥32 chars).
DSP_JWT_SECRET=dev-only-change-me
DSP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DSP_GRACEFUL_SHUTDOWN_SECONDS=30

# --- LLM (backend only — never expose to browser / NEXT_PUBLIC_*) ---
DEFAULT_AI_PROVIDER=deterministic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Frontend (build-time public — no secrets) ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_APP_NAME=DSP AI Indicator
NEXT_PUBLIC_AI_PROVIDER=deterministic
NEXT_PUBLIC_BUILD_TIMESTAMP=
# Enterprise surfaces (EPS-002) — foundation flags; Null billing / in-memory store.
NEXT_PUBLIC_ENTERPRISE_PORTAL=true
NEXT_PUBLIC_ENTERPRISE_ADMIN=true
NEXT_PUBLIC_ENTERPRISE_OPS=true
# Research Mode defaults (do not enable buy/sell theatre in RC)
NEXT_PUBLIC_RESEARCH_MODE=true
NEXT_PUBLIC_RECOMMENDATION_MODE=false
NEXT_PUBLIC_SHOW_BUY_SELL=false

# --- Observability hooks ---
DSP_RATE_LIMIT_ENABLED=false
DSP_RATE_LIMIT_PER_MINUTE=600

# --- Enterprise authentication (packages/auth + security_platform) ---
# See docs/AUTH_ENTERPRISE_PLATFORM.md — no Auth.js; thin client only.
DSP_AUTH_JWT_SECRET=
DSP_COOKIE_AUTH=true
DSP_COOKIE_SECURE=false
DSP_SEED_ADMIN_PASSWORD=Admin@123
DSP_PASSWORD_HASHER=argon2id
DSP_AUTH_LOCKOUT_THRESHOLD=5
DSP_AUTH_LOCKOUT_SECONDS=900
DSP_AUTH_SELF_REGISTER=true
DSP_AUTH_MAGIC_LINK=false
# Gates TOTP MFA step-up (/auth/mfa/totp/*) AND WebAuthn/Passkey — both
# step-up (/auth/mfa/webauthn/*) and primary passwordless (/auth/passkey/*).
DSP_AUTH_MFA=false
# Passkey / WebAuthn — required in production when DSP_AUTH_MFA=true.
# RP ID must be the exact host the browser navigates to; ORIGIN must be the
# exact scheme+host+port (HTTPS required outside localhost).
DSP_WEBAUTHN_RP_ID=localhost
DSP_WEBAUTHN_RP_NAME=DSP AI Indicator
DSP_WEBAUTHN_ORIGIN=http://localhost:3000
# TOTP MFA secret-at-rest encryption key (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Falls back to a key derived from DSP_AUTH_JWT_SECRET when unset (dev-only —
# set this explicitly in production for independent key rotation).
DSP_MFA_SECRET_KEY=
# Comma-separated retired keys, tried decrypt-only during key rotation.
DSP_MFA_SECRET_KEY_PREVIOUS=
# "Remember this device" MFA-skip TTL, in days (always expires — never permanent).
DSP_AUTH_TRUSTED_DEVICE_DAYS=30

# OAuth (omit credentials → status unavailable / hidden in UI)
DSP_GOOGLE_CLIENT_ID=
DSP_GOOGLE_CLIENT_SECRET=
DSP_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback
DSP_MICROSOFT_CLIENT_ID=
DSP_MICROSOFT_CLIENT_SECRET=
DSP_MICROSOFT_TENANT_ID=common
DSP_MICROSOFT_REDIRECT_URI=http://localhost:3000/oauth/callback
# DSP_FACEBOOK_CLIENT_ID/SECRET is the canonical name (matches Google/
# Microsoft); DSP_FACEBOOK_APP_ID/SECRET (Meta's own terminology) also
# works as a fallback for backward compatibility — set one pair, not both.
DSP_FACEBOOK_CLIENT_ID=
DSP_FACEBOOK_CLIENT_SECRET=
DSP_FACEBOOK_APP_ID=
DSP_FACEBOOK_APP_SECRET=
DSP_FACEBOOK_REDIRECT_URI=http://localhost:3000/oauth/callback

# Intentional disable → coming_soon (auto|disabled)
DSP_AUTH_PROVIDER_GOOGLE=auto
DSP_AUTH_PROVIDER_MICROSOFT=auto
DSP_AUTH_PROVIDER_FACEBOOK=auto
DSP_AUTH_PROVIDER_OTP=auto

# SMS OTP (console|dev|null|twilio|msg91|firebase)
DSP_SMS_PROVIDER=console
DSP_OTP_TTL_SECONDS=300
DSP_OTP_RESEND_SECONDS=30
DSP_TWILIO_ACCOUNT_SID=
DSP_TWILIO_AUTH_TOKEN=
DSP_TWILIO_FROM_NUMBER=
DSP_MSG91_AUTH_KEY=
DSP_MSG91_SENDER_ID=DSPAI
DSP_MSG91_TEMPLATE_ID=
DSP_FIREBASE_API_KEY=

DSP_EMAIL_PROVIDER=console
DSP_PUBLIC_WEB_ORIGIN=http://localhost:3000
DSP_PUBLIC_API_ORIGIN=http://localhost:8000

# --- Enterprise multi-provider auth (docs/security/ENTERPRISE_AUTH_PLATFORM.md) ---
DSP_AUTH_JWT_SECRET=
DSP_COOKIE_AUTH=true
DSP_CSRF_ENABLED=true
DSP_COOKIE_SECURE=false
DSP_COOKIE_SAMESITE=lax
DSP_PASSWORD_HASHER=bcrypt
DSP_SEED_ADMIN_PASSWORD=Admin@123
DSP_FORCE_ADMIN_SEED=0
# Google OAuth (leave empty → buttons disabled / honest unavailable)
DSP_GOOGLE_CLIENT_ID=
DSP_GOOGLE_CLIENT_SECRET=
# Microsoft Entra / Azure AD / Office 365
DSP_MICROSOFT_CLIENT_ID=
DSP_MICROSOFT_CLIENT_SECRET=
DSP_MICROSOFT_TENANT_ID=common
# Optional: default redirect_uri for the browser-navigable /auth/microsoft
# and /auth/microsoft/callback routes (the JSON SPA flow supplies its own).
DSP_MICROSOFT_REDIRECT_URI=
# Facebook OAuth (DSP_FACEBOOK_CLIENT_ID/SECRET preferred; DSP_FACEBOOK_APP_ID/SECRET also accepted)
DSP_FACEBOOK_CLIENT_ID=
DSP_FACEBOOK_CLIENT_SECRET=
DSP_FACEBOOK_APP_ID=
DSP_FACEBOOK_APP_SECRET=
# Optional: default redirect_uri for the browser-navigable /auth/facebook
# and /auth/facebook/callback routes (the JSON SPA flow supplies its own).
DSP_FACEBOOK_REDIRECT_URI=
# MFA (TOTP) + Passkey/WebAuthn — one flag gates both step-up (/auth/mfa/*)
# and primary passwordless sign-in (/auth/passkey/*); requires the optional
# `webauthn` package (pip install "auth[passkey]") for the Passkey routes.
DSP_AUTH_MFA=false
DSP_WEBAUTHN_RP_ID=localhost
DSP_WEBAUTHN_RP_NAME=DSP AI Indicator
DSP_WEBAUTHN_ORIGIN=http://localhost:3000
# TOTP MFA secret-at-rest encryption + "remember this device" TTL — see above.
DSP_MFA_SECRET_KEY=
DSP_MFA_SECRET_KEY_PREVIOUS=
DSP_AUTH_TRUSTED_DEVICE_DAYS=30
# SMS OTP — dev | null | twilio | msg91 | firebase
DSP_SMS_PROVIDER=dev
DSP_TWILIO_ACCOUNT_SID=
DSP_TWILIO_AUTH_TOKEN=
DSP_TWILIO_FROM_NUMBER=
DSP_MSG91_AUTH_KEY=
DSP_MSG91_SENDER_ID=DSPAI
DSP_MSG91_TEMPLATE_ID=
DSP_FIREBASE_API_KEY=
