# DSP AI Indicator — Production environment template (VPS + Neon)
# Copy to `.env.production` (gitignored) and fill real secrets on the VPS.
# DO NOT commit `.env.production`. Do not put real credentials in this file.
# DNS is unchanged until the VPS is validated.

# --- Identity & channel ---
DSP_ENVIRONMENT=production
DSP_APP_VERSION=2.0.0-rc.1
DSP_PLATFORM_VERSION=2.0.0
DSP_RELEASE_CHANNEL=rc
DSP_REGION=ap-south-1
BUILD_TIMESTAMP=
GIT_SHA=

# --- Public domain / TLS (Caddy, same origin for pages and /api/v1) ---
# Placeholder is the existing site hostname. Do not change DNS from this file.
DSP_PUBLIC_DOMAIN=dspaiindicator.com
DSP_ACME_EMAIL=ops@dspaiindicator.com
DSP_AUTO_HTTPS=on
# Use `off` only behind an upstream TLS terminator that already terminates HTTPS.

# --- Images ---
DSP_API_IMAGE=dsp-api
DSP_WEB_IMAGE=dsp-web
DSP_IMAGE_TAG=2.0.0-rc.1
DSP_IMAGE_TAG_WEB=2.0.0-rc.1
DSP_PREVIOUS_IMAGE_TAG=2.0.0
DSP_PREVIOUS_IMAGE_TAG_WEB=2.0.0

# --- API process ---
DSP_API_HOST=0.0.0.0
DSP_API_PORT=8000
DSP_GRACEFUL_SHUTDOWN_SECONDS=30
DSP_FORWARDED_ALLOW_IPS=*

# --- Security (required in production) ---
DSP_ENABLE_SECURITY=true
DSP_REQUIRE_ADMIN_AUTH=true
DSP_HSTS_ENABLED=true
DSP_RATE_LIMIT_ENABLED=true
DSP_RATE_LIMIT_PER_MINUTE=600
DSP_JWT_SECRET=CHANGE_ME_MIN_32_CHARS_VPS_SECRET
DSP_AUTH_JWT_SECRET=CHANGE_ME_MIN_32_CHARS_VPS_SECRET
DSP_SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
DSP_CORS_ORIGINS=https://dspaiindicator.com

# --- India posture / locale ---
DSP_INDIA_TIMEZONE=Asia/Kolkata
DSP_INDIA_CURRENCY=INR
TZ=Asia/Kolkata
LANG=en_IN.UTF-8

# --- DSP database (Neon direct connection, not the transaction pooler) ---
# psycopg leaves prepared statements enabled. Use the direct host and TLS.
# Replace USER, PASSWORD, and the host. Do not commit the real URL.
DSP_DATABASE_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/dsp?sslmode=require
# Redis is not required. Leave DSP_REDIS_URL unset. The API uses memory.

# --- Object / temp storage (memory is enough; no object bucket is required) ---
DSP_OBJECT_STORAGE_PROVIDER=memory
DSP_TEMP_DIR=/tmp/dsp
DSP_BACKUP_DIR=/var/backups/dsp
DSP_CERT_IN_LOG_RETENTION_DAYS=180

# --- AI providers (optional; deterministic default) ---
DEFAULT_AI_PROVIDER=deterministic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Authenticated market data (server-side only; never frontend) ---
# Official evidence only. Commercial vendors (FMP, Upstox) are rejected.
# DSP_INVESTMENT_DATA_PROVIDER=unavailable

# --- Frontend (build-time public — no secrets) ---
NEXT_PUBLIC_API_BASE_URL=https://dspaiindicator.com/api/v1
NEXT_PUBLIC_APP_NAME=DSP AI Indicator
NEXT_PUBLIC_AI_PROVIDER=backend
NEXT_PUBLIC_BUILD_TIMESTAMP=

# --- Closed beta (disable for public launch when conditions clear) ---
DSP_CLOSED_BETA=false
DSP_BETA_FEATURE_FLAG=false
DSP_BETA_INVITATION_ONLY=false
DSP_BETA_BANNER=false
DSP_BETA_BANNER_TEXT=
DSP_BETA_EXPIRY_AT=
DSP_BETA_READ_ONLY_SAFEGUARDS=false
DSP_BETA_INVITE_ALLOWLIST=

# --- Smoke / certification ---
DSP_SMOKE_API_BASE_URL=https://dspaiindicator.com
DSP_SMOKE_WEB_BASE_URL=https://dspaiindicator.com
DSP_SMOKE_REQUIRE_HTTPS=true

# Observability containers are not started by docker-compose.production.yml.
