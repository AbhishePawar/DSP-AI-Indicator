# DSP AI Indicator — Production environment template (EPIC-P7.0)
# Copy to `.env.production` (gitignored) and fill real secrets.
# DO NOT commit `.env.production`. Load secrets from KMS / Secrets Manager in enterprise.

# --- Identity & channel ---
DSP_ENVIRONMENT=production
DSP_APP_VERSION=2.0.0-rc.1
DSP_PLATFORM_VERSION=2.0.0
DSP_RELEASE_CHANNEL=rc
DSP_REGION=ap-south-1
BUILD_TIMESTAMP=
GIT_SHA=

# --- Public domain / TLS (Caddy) ---
DSP_PUBLIC_DOMAIN=app.your-domain.example
DSP_API_DOMAIN=api.your-domain.example
DSP_ACME_EMAIL=ops@your-domain.example
DSP_AUTO_HTTPS=on
# Use `off` only behind an upstream TLS terminator that already terminates HTTPS.

# --- Images ---
DSP_API_IMAGE=dsp-api
DSP_WEB_IMAGE=dsp-web
DSP_IMAGE_TAG=2.0.0-rc.1
DSP_IMAGE_TAG_WEB=2.0.0-rc.1
DSP_PREVIOUS_IMAGE_TAG=2.0.0
DSP_PREVIOUS_IMAGE_TAG_WEB=2.0.0

# --- API process ---
DSP_API_HOST=0.0.0.0
DSP_API_PORT=8000
DSP_GRACEFUL_SHUTDOWN_SECONDS=30
DSP_FORWARDED_ALLOW_IPS=*

# --- Security (required in production) ---
DSP_ENABLE_SECURITY=true
DSP_REQUIRE_ADMIN_AUTH=true
DSP_HSTS_ENABLED=true
DSP_RATE_LIMIT_ENABLED=true
DSP_RATE_LIMIT_PER_MINUTE=600
DSP_JWT_SECRET=CHANGE_ME_USE_SECRET_MANAGER_MIN_32_CHARS
DSP_SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
DSP_CORS_ORIGINS=https://app.your-domain.example

# --- India posture / locale ---
DSP_INDIA_TIMEZONE=Asia/Kolkata
DSP_INDIA_CURRENCY=INR
TZ=Asia/Kolkata
LANG=en_IN.UTF-8

# --- Data stores (compose defaults wire to in-stack postgres/redis) ---
POSTGRES_USER=dsp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=dsp
DSP_DATABASE_URL=postgresql://dsp:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/dsp
DSP_REDIS_URL=redis://redis:6379/0
DSP_REDIS_FALLBACK=false

# --- Object / temp storage ---
DSP_OBJECT_STORAGE_PROVIDER=s3
DSP_OBJECT_STORAGE_BUCKET=dsp-prod-artifacts
DSP_OBJECT_STORAGE_REGION=ap-south-1
DSP_TEMP_DIR=/tmp/dsp
DSP_BACKUP_DIR=/var/backups/dsp
DSP_CERT_IN_LOG_RETENTION_DAYS=180

# --- AI providers (optional; deterministic default) ---
DEFAULT_AI_PROVIDER=deterministic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Frontend (build-time public — no secrets) ---
NEXT_PUBLIC_API_BASE_URL=https://app.your-domain.example/api/v1
NEXT_PUBLIC_APP_NAME=DSP AI Indicator
NEXT_PUBLIC_AI_PROVIDER=backend
NEXT_PUBLIC_BUILD_TIMESTAMP=

# --- Closed beta (disable for public launch when conditions clear) ---
DSP_CLOSED_BETA=false
DSP_BETA_FEATURE_FLAG=false
DSP_BETA_INVITATION_ONLY=false
DSP_BETA_BANNER=false
DSP_BETA_BANNER_TEXT=
DSP_BETA_EXPIRY_AT=
DSP_BETA_READ_ONLY_SAFEGUARDS=false
DSP_BETA_INVITE_ALLOWLIST=

# --- Smoke / certification ---
DSP_SMOKE_API_BASE_URL=https://app.your-domain.example
DSP_SMOKE_WEB_BASE_URL=https://app.your-domain.example
DSP_SMOKE_REQUIRE_HTTPS=true

# --- Observability (P7.4) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN
GRAFANA_HOST_PORT=3001
GRAFANA_ROOT_URL=https://grafana.your-domain.example
